<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    
    <persistence-unit name="nextgen-cp-v2">
        <class>com.nextgen.desktop.v2.db.entities.ServerEntity</class>
        <class>com.nextgen.desktop.v2.db.entities.NodeEntity</class>
        <class>com.nextgen.desktop.v2.db.entities.ClusterMembershipEntity</class>
        <class>com.nextgen.desktop.v2.db.entities.JoinRequestEntity</class>
        
        <properties>
            <!-- These will be overridden programmatically -->
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:cluster.db"/>
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>
