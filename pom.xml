<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nextgen</groupId>
    <artifactId>next-gen-control-plane</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Next-Gen Control Plane</name>
    <description>Root parent POM for Next-Gen Control Plane project</description>

    <modules>
        <module>java-control-plane</module>
        <module>desktop-ui</module>
        <module>cli</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- gRPC & Protobuf — bumped from 1.68.0/3.25.5 (2026-08): 1.68.0's grpc-netty-shaded is
             vulnerable to CVE-2025-55163 (MadeYouReset HTTP/2 DoS), fixed in 1.75.0+; upgraded to the
             latest stable (1.83.1, confirmed via repo1.maven.org/.../grpc-core/maven-metadata.xml) to
             pick up every subsequent fix, not just this one. protobuf.version bumped to the matching
             3.25.8 patch (same 3.25.x line grpc-java 1.83.1 itself builds against per its own
             protoc-gen-grpc-java pairing), not a major-version jump. Verified against this project's
             full real test suite (Raft/task-channel/docker-channel gRPC surface included) before
             landing, not assumed compatible from release notes alone. -->
        <grpc.version>1.83.1</grpc.version>
        <protobuf.version>3.25.8</protobuf.version>

        <!-- JavaFX -->
        <javafx.version>21.0.2</javafx.version>

        <!-- Jackson — bumped from 2.17.0 (2026-08): that version is affected by five real
             jackson-databind CVEs (CVE-2026-59888 @JsonIgnore/Record bypass, CVE-2026-54515
             case-insensitive @JsonIgnoreProperties bypass, CVE-2026-54514 InetSocketAddress
             deserialization SSRF, CVE-2026-54512/54513 PolymorphicTypeValidator bypasses —
             confirmed via api.osv.dev, not assumed), the highest of which needs >= 2.18.9 in the
             2.x line. Bumped to the latest stable (2.22.1, confirmed via
             repo1.maven.org/.../jackson-databind/maven-metadata.xml) to pick up every subsequent
             fix, matching the grpc.version bump's own verify-via-authoritative-source discipline. -->
        <jackson.version>2.22.1</jackson.version>

        <!-- Prometheus -->
        <prometheus.version>0.16.0</prometheus.version>

        <!-- OSHI: cross-platform battery/charging/AC-power signals (no such library existed before) -->
        <oshi.version>6.6.5</oshi.version>

        <!-- Logging -->
        <slf4j.version>2.0.16</slf4j.version>

        <!-- Testing -->
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.11.0</mockito.version>
        <awaitility.version>4.2.2</awaitility.version>
        <!--
          0.8.12 predates JDK 26 and cannot read class file major version 70. Its agent throws
          while instrumenting JDK and third-party classes, which intermittently kills test-class
          loading outright ("Unable to create test class ..."). 0.8.15 understands the newer format.
        -->
        <jacoco.version>0.8.15</jacoco.version>

        <!-- BouncyCastle — bumped from 1.78.1 (2026-08): affected by CVE-2025-8916 (bcpkix/bcprov
             PKIXCertPathReviewer excessive-allocation DoS — directly relevant, this project's
             CertificateAuthority does real X.509 cert-path handling; needs >= 1.79) and
             CVE-2026-5588 (bcpkix CompositeVerifier accepts an empty signature sequence as valid;
             needs >= 1.84), both confirmed via api.osv.dev. Bumped to 1.85 — the latest version
             published for all three artifacts this project depends on (bcpkix-jdk18on,
             bcprov-jdk18on, bcutil-jdk18on all confirmed on repo1.maven.org; bcprov-jdk18on alone
             has a newer 1.85.2 but the other two do not, so 1.85 is the highest common version). -->
        <bouncycastle.version>1.85</bouncycastle.version>

        <!-- Maven Plugins -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.version>3.2.5</maven.surefire.version>
        <maven.shade.version>3.5.1</maven.shade.version>
        <maven.clean.version>3.3.2</maven.clean.version>
        <maven.resources.version>3.3.1</maven.resources.version>
        <maven.jar.version>3.3.0</maven.jar.version>
        <build.helper.version>3.5.0</build.helper.version>
        <protobuf.plugin.version>0.6.1</protobuf.plugin.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <os.plugin.version>1.7.1</os.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- gRPC -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-netty-shaded</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-protobuf</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-stub</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-testing</artifactId>
                <version>${grpc.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-inprocess</artifactId>
                <version>${grpc.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- JavaFX -->
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-web</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
            </dependency>

            <!-- Jackson -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Prometheus -->
            <dependency>
                <groupId>io.prometheus</groupId>
                <artifactId>simpleclient</artifactId>
                <version>${prometheus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.prometheus</groupId>
                <artifactId>simpleclient_httpserver</artifactId>
                <version>${prometheus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.prometheus</groupId>
                <artifactId>simpleclient_hotspot</artifactId>
                <version>${prometheus.version}</version>
            </dependency>

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- OSHI -->
            <dependency>
                <groupId>com.github.oshi</groupId>
                <artifactId>oshi-core</artifactId>
                <version>${oshi.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
                <scope>test</scope>
            </dependency>

            <!--
              BouncyCastle — used purely as an ASN.1/PEM/X.509 library, NEVER registered as a JCE
              provider via Security.addProvider(). The shade plugin strips META-INF/*.SF|DSA|RSA,
              which destroys BouncyCastle's jar-signature self-integrity check; registering it as a
              provider would therefore pass `mvn test` and fail only inside the shaded jar.

              Creating real signed X.509 certificates without it is not practical here: the
              sun.security.x509 route needs an add-exports flag in the surefire argLine, the shaded
              jar manifest AND the Docker entrypoint, and its API changed between JDK 17 and 21
              while we build on JDK 26. Shelling out to keytool needs a full JDK at runtime; the
              images are JRE-based.
            -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- Annotations -->
            <dependency>
                <groupId>javax.annotation</groupId>
                <artifactId>javax.annotation-api</artifactId>
                <version>1.3.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven.clean.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build.helper.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.xolstice.maven.plugins</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>${javafx.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
