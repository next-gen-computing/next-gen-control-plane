<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nextgen</groupId>
        <artifactId>next-gen-control-plane</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>desktop-ui</artifactId>
    <packaging>jar</packaging>

    <name>Desktop UI</name>
    <description>Modern JavaFX desktop application for Next-Gen Control Plane</description>

    <!-- See java-control-plane/pom.xml for why the Windows-only java.io.tmpdir property that
         used to live here was removed rather than kept: it never worked and was actively
         wrong on macOS/Linux. -->

    <dependencies>
        <!--
          Control plane core. This provides three things the UI needs:
            1. The generated com.nextgen.proto.* classes, so this module no longer regenerates the
               same proto independently. It must not — two copies of ControlPlaneProto on one
               classpath is a duplicate-class hazard.
            2. ControlPlaneServer, which DesktopApp's "Launch Server" starts. It previously reached
               for it via Class.forName without a dependency, so in the shaded jar that call ALWAYS
               threw ClassNotFoundException, logged a warning, and showed a dashboard for a server
               that was never started.
            3. Shared configuration (EnvConfig) and the NodeStatus domain enum.
        -->
        <dependency>
            <groupId>com.nextgen</groupId>
            <artifactId>control-plane</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- gRPC Client -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>

        <!-- Annotation API (required by generated gRPC stubs) -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
        <!-- WebView: hosts the HTML/CSS/JS frontend served by LocalUiServer. Version is already
             managed centrally in the root pom's dependencyManagement. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <!-- OS detection for protoc binary -->
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os.plugin.version}</version>
            </extension>
        </extensions>

        <plugins>
            <!--
              No maven-clean-plugin override here. This module no longer runs
              protobuf-maven-plugin (see the note below), so the protoc-dependencies fileset a
              previous version of this file cleaned is dead configuration: that directory is
              never created by this module's build anymore.
            -->

            <!--
              Requires a JDK 21 Maven Toolchain — this is what makes `mvn javafx:run` work
              correctly even when Maven itself is running on a newer JDK. javafx-web's module
              descriptor requires the `jdk.jsobject` module (backs WebView's Java<->JavaScript
              bridge), which was removed from the JDK in later feature releases (confirmed gone
              by JDK 26; present through at least JDK 21) — javafx-maven-plugin's `run` goal
              otherwise launches the app with whatever JVM is running Maven, which fails at boot
              with `FindException: Module jdk.jsobject not found` on such a JVM.
              javafx-maven-plugin has built-in support for picking up whatever toolchain this
              plugin selects (via ToolchainManager) and launching the app with THAT JDK instead
              — so the system-default `java`/JAVA_HOME never needs to change; only compiling and
              running desktop-ui specifically routes through JDK 21.
              One-time setup this depends on: a `~/.m2/toolchains.xml` declaring a JDK 21
              install. See DEVELOPMENT.md's "Build & Launch" section.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>21</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!--
              NOTE: protobuf-maven-plugin and build-helper are deliberately absent here. The
              generated com.nextgen.proto.* classes now arrive via the control-plane dependency.
              Re-adding local generation would put two copies of every proto class on one classpath.
            -->

            <!-- Surefire: matches the control-plane module so JaCoCo's argLine is honoured.
                 forkedProcessTimeoutInSeconds is a real, previously-missing safety net: this module's
                 full suite runs in well under two minutes locally, so a real CI run (a JavaFX toolkit
                 startup or a headless-environment quirk neither of which shows up on a machine with a
                 real display) hanging for HOURS instead of failing was a genuine, confirmed problem —
                 GitHub Actions' own default job timeout is 6 hours, so nothing would have stopped it
                 otherwise. Bounded generously (well over 10x the normal local runtime) so this only
                 ever fires on a genuine hang, never a slow-but-legitimate CI run, and Surefire dumps
                 the forked JVM's thread state on timeout — turning a silent multi-hour stall into an
                 immediate, diagnosable failure with a real stack trace. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true -Djava.awt.headless=true</argLine>
                    <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
                    <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
                </configuration>
            </plugin>

            <!-- JaCoCo: this module previously had no coverage measurement at all -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- JavaFX view classes need a running toolkit and a display; they are
                             verified by running the app, not by unit tests. Counting them would
                             measure the wrong thing. -->
                        <exclude>com/nextgen/desktop/ui/view/**</exclude>
                        <exclude>com/nextgen/desktop/ui/DesktopApp*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <!-- Measured on the client/model/service layer (views are
                                             excluded above): 61.0% instruction / 45.3% branch at
                                             the time this gate was set. -->
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.42</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JavaFX Maven Plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.nextgen.desktop.ui.DesktopApp</mainClass>
                </configuration>
            </plugin>

            <!-- Shade plugin to build fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <!-- Launcher, not DesktopApp: see Launcher's Javadoc. A Main-Class that
                                         directly extends javafx.application.Application makes the java
                                         launcher demand JavaFX on the module path, which "java -jar" on a
                                         shaded jar never provides — it fails before main() even runs. -->
                                    <mainClass>com.nextgen.desktop.ui.Launcher</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
