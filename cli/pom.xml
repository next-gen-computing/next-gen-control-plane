<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nextgen</groupId>
        <artifactId>next-gen-control-plane</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>nextgen-cli</artifactId>
    <packaging>jar</packaging>

    <name>NextGen CLI</name>
    <description>The nx command-line tool — submits distributed docker-compose-style jobs to the
        control plane, modeled directly on docker compose's own up/down/ps/logs commands (Stage R).
    </description>

    <properties>
        <!-- SnakeYAML: real docker-compose.yml parsing. No YAML library exists anywhere else in this
             project (java-control-plane/desktop-ui have no YAML need) — this is a new module's own
             dependency, so it adds zero footprint to either of those. SnakeYAML is the de facto
             standard Java YAML library: widely used, no transitive dependency bloat, actively
             maintained. -->
        <snakeyaml.version>2.2</snakeyaml.version>
    </properties>

    <dependencies>
        <!--
          Control plane core — reused unmodified rather than duplicated (matching desktop-ui's own
          precedent, see its pom.xml comment): the generated com.nextgen.proto.* classes, the shared
          ControlPlaneEndpoints/ControlPlaneConnection connection machinery, AgentCredentials, TlsConfig,
          and NodeAgent.ensureEnrolled — the CLI enrols through the exact same flow a real node does
          (see NodeAgent.ensureEnrolled's own Javadoc: "Public so ... a second, divergent copy of it").
        -->
        <dependency>
            <groupId>com.nextgen</groupId>
            <artifactId>control-plane</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- No protobuf-maven-plugin here either — same reasoning as desktop-ui's pom.xml: the
                 generated com.nextgen.proto.* classes arrive transitively via control-plane. -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- Shade plugin: a single fat jar needing only a JRE on PATH, matching java-control-plane's
                 own -all classifier and desktop-ui's Launcher-based shaded jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.nextgen.cli.Cli</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
